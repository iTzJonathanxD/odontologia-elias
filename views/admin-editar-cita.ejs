<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editar Cita</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f0f4f8;
        }
        
        .card {
            max-width: 650px;
            margin: 50px auto;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.1);
        }
        
        .form-label {
            font-weight: 600;
        }
        
        .titulo {
            font-size: 1.8rem;
            font-weight: bold;
            color: #0d6efd;
        }
        
        .btn-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
        
        .btn-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
        }
    </style>
</head>

<body>
    <%- include('adminHOMEheader') %>

        <div class="container">
            <div class="card bg-white">
                <h2 class="titulo text-center mb-4"><i class="bi bi-pencil-square"></i> Editar Cita</h2>

                <% if (message) { %>
                    <div class="alert alert-<%= message.type %> alert-dismissible fade show" role="alert">
                        <%= message.text %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                    <% } %>

                        <form action="/admin/citas/editar/<%= cita.id %>" method="POST">

                            <div class="mb-3">
                                <label for="fecha" class="form-label">Fecha</label>
                                <input type="date" id="fecha" name="fecha" class="form-control" required value="<%= cita.fecha.toISOString().split('T')[0] %>" />
                            </div>

                            <div class="mb-3">
                                <label for="hora" class="form-label">Hora</label>
                                <input type="time" id="hora" name="hora" class="form-control" required value="<%= cita.hora %>" />
                            </div>

                            <div class="mb-3">
                                <label for="especialidad" class="form-label">Especialidad</label>
                                <select id="especialidad" name="especialidad" class="form-select" required>
                        <option value="">Seleccione el servicio</option>
                        <% const opciones = ['Odontología General', 'Ortodoncia', 'Cirugía de tercer molares', 'Restauración Estética', 'Odontopediatria', 'Exodoncia', 'Endodoncia', 'Profilaxis', 'Aclaramiento Dental', 'Prótesis fijas y removibles']; %>
                        <% opciones.forEach(opcion => { %>
                            <option value="<%= opcion %>" <%= cita.especialidad === opcion ? 'selected' : '' %>><%= opcion %></option>
                        <% }) %>
                    </select>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <a href="/admin-citas-agendadas" class="btn btn-secondary"><i class="bi bi-arrow-left-circle"></i> Cancelar</a>
                                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar Cambios</button>
                            </div>
                        </form>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>