<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editar Cita</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: #f0f4f8;
        }
        
        .card {
            max-width: 600px;
            margin: auto;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }
        
        .form-label {
            font-weight: 600;
        }
        
        .titulo {
            font-size: 1.8rem;
            font-weight: bold;
            color: #0d6efd;
        }
        
        .btn-primary {
            background-color: #0d6efd;
        }
        
        .modal-body {
            font-size: 1.1rem;
        }
    </style>
</head>

<body>

    <div class="container py-5">
        <div class="card p-4 bg-white rounded-4">
            <h2 class="titulo text-center mb-4"><i class="bi bi-calendar-check-fill"></i> Editar Cita</h2>

            <form id="formEditarCita">
                <input type="hidden" name="id" value="<%= cita.id %>" />

                <!-- Fecha -->
                <div class="mb-3">
                    <label for="fecha" class="form-label">Fecha</label>
                    <input type="date" class="form-control" id="fecha" name="fecha" value="<%= cita.fecha.toISOString().split('T')[0] %>" required />
                </div>

                <!-- Hora -->
                <div class="mb-3">
                    <label for="hora" class="form-label">Hora</label>
                    <input type="time" class="form-control" id="hora" name="hora" value="<%= cita.hora %>" required />
                </div>

                <!-- Especialidad -->
                <div class="mb-3">
                    <label for="especialidad" class="form-label">Especialidad</label>
                    <select class="form-select" id="especialidad" name="especialidad" required>
                        <option value="Odontología General" <%= cita.especialidad === 'Odontología General' ? 'selected' : '' %>>Odontología General</option>
                        <option value="Ortodoncia" <%= cita.especialidad === 'Ortodoncia' ? 'selected' : '' %>>Ortodoncia</option>
                        <option value="Cirugía de tercer molares" <%= cita.especialidad === 'Cirugía de tercer molares' ? 'selected' : '' %>>Cirugía de tercer molares</option>
                        <option value="Restauración Estética" <%= cita.especialidad === 'Restauración Estética' ? 'selected' : '' %>>Restauración Estética</option>
                        <option value="Odontopediatría" <%= cita.especialidad === 'Odontopediatría' ? 'selected' : '' %>>Odontopediatría</option>
                        <option value="Exodoncia" <%= cita.especialidad === 'Exodoncia' ? 'selected' : '' %>>Exodoncia</option>
                        <option value="Endodoncia" <%= cita.especialidad === 'Endodoncia' ? 'selected' : '' %>>Endodoncia</option>
                        <option value="Profilaxis" <%= cita.especialidad === 'Profilaxis' ? 'selected' : '' %>>Profilaxis</option>
                        <option value="Aclaramiento Dental" <%= cita.especialidad === 'Aclaramiento Dental' ? 'selected' : '' %>>Aclaramiento Dental</option>
                        <option value="Prótesis fijas y removibles" <%= cita.especialidad === 'Prótesis fijas y removibles' ? 'selected' : '' %>>Prótesis fijas y removibles</option>
                    </select>
                </div>

                <!-- Botones -->
                <div class="d-flex justify-content-between mt-4">
                    <a href="/admin-recepcionista-citas" class="btn btn-secondary"><i class="bi bi-arrow-left-circle"></i> Cancelar</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal flotante de mensaje -->
    <div class="modal fade" id="modalMensaje" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content text-center border-0 shadow-lg">
                <div class="modal-body py-4">
                    <div id="mensajeTexto" class="fw-bold"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const inputFecha = document.getElementById('fecha');
        const hoy = new Date().toISOString().split('T')[0];
        inputFecha.min = hoy;

        inputFecha.addEventListener('change', () => {
            if (inputFecha.value < hoy) {
                mostrarMensaje('Seleccione una fecha actual o futura', 'danger');
                inputFecha.value = '';
            }
        });

        function mostrarMensaje(texto, tipo = 'success') {
            const mensajeModal = new bootstrap.Modal(document.getElementById('modalMensaje'));
            const mensajeTexto = document.getElementById('mensajeTexto');
            mensajeTexto.textContent = texto;
            mensajeTexto.className = 'text-' + (tipo === 'success' ? 'success' : 'danger');
            mensajeModal.show();
        }

        document.getElementById('formEditarCita').addEventListener('submit', async function(event) {
            event.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const res = await fetch(`/recepcionista/citas/editar/${data.id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await res.json();
                if (res.ok) {
                    mostrarMensaje(result.success || 'Cita actualizada');
                    setTimeout(() => location.href = '/admin-recepcionista-citas', 2000);
                } else {
                    mostrarMensaje(result.error || 'Error al actualizar', 'danger');
                }
            } catch (error) {
                mostrarMensaje('Error al conectar con el servidor', 'danger');
            }
        });
    </script>
</body>

</html>