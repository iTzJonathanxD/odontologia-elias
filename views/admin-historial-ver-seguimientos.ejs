<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Seguimientos del Historial</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .seguimiento-card {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            background-color: #fafafa;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.06);
        }
        
        .seguimiento-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .seguimiento-header h5 {
            margin: 0;
        }
        
        .btn-editar {
            font-size: 0.9rem;
        }
    </style>
</head>

<body>
    <%- include('adminHOMEheader') %>

        <div class="container mt-4 mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="mb-0">Seguimientos de
                    <%= paciente.nombre %>
                </h3>
                <a href="/admin-todos-historiales" class="btn btn-secondary">Volver</a>
            </div>

            <% if (seguimientos.length > 0) { %>
                <% seguimientos.forEach(s => { %>
                    <div class="seguimiento-card">
                        <div class="seguimiento-header mb-3">
                            <h5>Seguimiento del
                                <%= new Date(s.created_at).toLocaleDateString() %>
                            </h5>
                            <a href="/admin/editar-seguimiento/<%= s.id %>" class="btn btn-outline-primary btn-sm btn-editar">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <strong>Tratamientos:</strong>
                                <p class="mb-0">
                                    <%= s.tratamientos %>
                                </p>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Medicamentos:</strong>
                                <p class="mb-0">
                                    <%= s.medicamentos %>
                                </p>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Prescripción:</strong>
                                <p class="mb-0">
                                    <%= s.prescripcion %>
                                </p>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Observaciones:</strong>
                                <p class="mb-0">
                                    <%= s.observaciones %>
                                </p>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div class="alert alert-warning mt-4">No hay seguimientos registrados para este historial clínico.</div>
                            <% } %>
        </div>

        <!-- Bootstrap icons -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css">
</body>

</html>