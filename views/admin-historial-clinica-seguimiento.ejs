<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Seguimiento de Historial Clínico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .form-section {
            margin-bottom: 1.5rem;
        }
        
        .form-section h5 {
            background-color: #f0f0f0;
            padding: 0.5rem;
            margin-bottom: 1rem;
            border-radius: 5px;
            font-weight: bold;
        }
        
        textarea.form-control,
        input.form-control {
            font-size: 0.95rem;
        }
        
        .form-label {
            font-weight: 500;
        }
    </style>
</head>

<body>
    <%- include('adminHOMEheader') %>

        <div class="container mt-4 mb-5">
            <h3 class="mb-4">Seguimiento -
                <%= paciente.nombre %>
            </h3>

            <form method="POST" action="/admin/historial-clinico/<%= paciente.id %>/seguimiento/<%= historial.id %>">

                <!-- 🔒 DATOS ANTERIORES -->
                <div class="form-section">
                    <h5>Datos del Historial Anterior</h5>

                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label class="form-label">Código HC</label>
                            <input type="text" class="form-control" name="codigo_hc" value="<%= paciente.cedula || paciente.pasaporte %>" readonly>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Código Diagnóstico</label>
                            <input type="text" class="form-control" value="<%= historial.codigo_diagnostico %>" readonly>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Diagnóstico</label>
                            <input type="text" class="form-control" value="<%= historial.nombre_diagnostico %>" readonly>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Tratamientos anteriores</label>
                            <textarea class="form-control" rows="2" readonly><%= historial.tratamientos %></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Observaciones anteriores</label>
                            <textarea class="form-control" rows="2" readonly><%= historial.observaciones %></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Prescripción anterior</label>
                            <textarea class="form-control" rows="2" readonly><%= historial.prescripcion %></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Medicamentos anteriores</label>
                            <textarea class="form-control" rows="2" readonly><%= historial.medicamentos %></textarea>
                        </div>
                    </div>
                </div>

                <!-- ✅ DATOS DEL SEGUIMIENTO -->
                <div class="form-section">
                    <h5>Nuevo Seguimiento</h5>

                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label class="form-label">Código HC</label>
                            <input type="text" class="form-control" name="codigo_hc" value="<%= paciente.cedula || paciente.pasaporte %>" readonly>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Fecha de Seguimiento</label>
                            <input type="date" class="form-control" name="fecha_seguimiento" required>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Tratamientos nuevos</label>
                            <textarea class="form-control" name="tratamientos" rows="2" required></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Observaciones nuevas</label>
                            <textarea class="form-control" name="observaciones" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Medicamentos nuevos</label>
                            <textarea class="form-control" name="medicamentos" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Prescripción nueva</label>
                            <textarea class="form-control" name="prescripcion" rows="2"></textarea>
                        </div>
                    </div>
                </div>

                <!-- 🔒 Campo oculto -->
                <input type="hidden" name="seguimiento_de" value="<%= historial.id %>">

                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-success">Guardar Seguimiento</button>
                    <a href="/admin-todos-historiales" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
</body>

</html>