<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Otras Especialidades - Odontología Especializada Dra. Josseline Delgado</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f7fa;
            margin: 0;
            padding: 0;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .fadeInUp {
            animation: fadeInUp 1s ease forwards;
        }
        
        .hero-section {
            background-image: url('/images/otras-especialidades.png');
            background-size: cover;
            background-position: center;
            height: 400px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
            animation: fadeInUp 1s ease forwards 0.2s;
        }
        
        .hero-section h1 {
            font-size: 3rem;
            font-weight: 700;
            color: #0d6efd;
            margin-bottom: 0.25rem;
        }
        
        .hero-section p {
            font-size: 1.3rem;
            color: #131313;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.6);
        }
        
        .services-section {
            padding: 60px 20px;
            text-align: center;
            animation: fadeInUp 1s ease forwards 0.5s;
        }
        
        .services-section h2 {
            font-size: 2.5rem;
            font-weight: 700;
            color: #0d6efd;
            margin-bottom: 40px;
        }
        
        .service-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
            animation: fadeInUp 1s ease forwards 0.8s;
        }
        
        .service-box {
            background-color: #fff;
            border-radius: 15px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
            padding: 30px 25px;
            width: 300px;
            cursor: pointer;
            transition: transform 0.3s, box-shadow 0.3s;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        
        .service-box:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 35px rgba(0, 0, 0, 0.15);
        }
        
        .service-box img {
            max-width: 120px;
            margin-bottom: 20px;
            border-radius: 12px;
            object-fit: cover;
        }
        
        .service-box h3 {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 12px;
            color: #0a58ca;
            text-align: center;
        }
        
        .service-box p {
            font-size: 1rem;
            color: #555;
            text-align: center;
            margin-bottom: 16px;
        }
        
        .btn-ver {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 16px;
            background-color: #0d6efd;
            color: white;
            font-weight: 600;
            border-radius: 8px;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }
        
        .btn-ver:hover {
            background-color: #0b5ed7;
        }
        
        .modal-header {
            background-color: #0d6efd;
            color: white;
        }
    </style>
</head>

<body>
    <%- include('nav') %>

        <section class="hero-section" aria-label="Imagen y título principal de otras especialidades">
        </section>

        <div class="services-section fadeInUp">
            <h2>Nuestros Tratamientos Especializados</h2>
            <div class="service-container fadeInUp">

                <div class="service-box" onclick="mostrarMensaje('Debe iniciar sesión o crear una cuenta')">
                    <img src="/images/endodoncia.jpg" alt="Endodoncia">
                    <h3>Endodoncia</h3>
                    <p>Tratamiento de conductos para salvar dientes dañados.</p>
                    <a href="/login" class="btn-ver"><i class="bi bi-box-arrow-in-right"></i> Ver</a>
                </div>

                <div class="service-box" onclick="mostrarMensaje('Debe iniciar sesión o crear una cuenta')">
                    <img src="/images/odontopediatria.png" alt="Odontopediatría">
                    <h3>Odontopediatría</h3>
                    <p>Atención dental especializada para niños.</p>
                    <a href="/login" class="btn-ver"><i class="bi bi-box-arrow-in-right"></i> Ver</a>
                </div>

                <div class="service-box" onclick="mostrarMensaje('Debe iniciar sesión o crear una cuenta')">
                    <img src="/images/implantes-dentales.jpg" alt="Implantes Dentales">
                    <h3>Implantes Dentales</h3>
                    <p>Soluciones permanentes para dientes perdidos.</p>
                    <a href="/login" class="btn-ver"><i class="bi bi-box-arrow-in-right"></i> Ver</a>
                </div>

                <div class="service-box" onclick="mostrarMensaje('Debe iniciar sesión o crear una cuenta')">
                    <img src="/images/estetica-dental.jpg" alt="Estética Dental">
                    <h3>Estética Dental</h3>
                    <p>Mejora de la apariencia de tus dientes.</p>
                    <a href="/login" class="btn-ver"><i class="bi bi-box-arrow-in-right"></i> Ver</a>
                </div>

                <div class="service-box" onclick="mostrarMensaje('Debe iniciar sesión o crear una cuenta')">
                    <img src="/images/exodoncia.jpg" alt="Exodoncia">
                    <h3>Exodoncia</h3>
                    <p>Extracción de dientes que no pueden ser salvados.</p>
                    <a href="/login" class="btn-ver"><i class="bi bi-box-arrow-in-right"></i> Ver</a>
                </div>

                <div class="service-box" onclick="mostrarMensaje('Debe iniciar sesión o crear una cuenta')">
                    <img src="/images/profilaxis.jpg" alt="Profilaxis">
                    <h3>Profilaxis</h3>
                    <p>Limpieza dental profesional para mantener la salud bucal.</p>
                    <a href="/login" class="btn-ver"><i class="bi bi-box-arrow-in-right"></i> Ver</a>
                </div>

                <div class="service-box" onclick="mostrarMensaje('Debe iniciar sesión o crear una cuenta')">
                    <img src="/images/protesis.jpg" alt="Prótesis Fijas y Removibles">
                    <h3>Prótesis Fijas y Removibles</h3>
                    <p>Soluciones para reemplazar dientes perdidos.</p>
                    <a href="/login" class="btn-ver"><i class="bi bi-box-arrow-in-right"></i> Ver</a>
                </div>

            </div>
        </div>

        <!-- Modal -->
        <div class="modal fade" id="infoModal" tabindex="-1" aria-labelledby="infoModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="infoModalLabel">Aviso</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body" id="modalBodyContent"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            const infoModal = new bootstrap.Modal(document.getElementById('infoModal'));

            function mostrarMensaje(texto) {
                document.getElementById('modalBodyContent').textContent = texto;
                infoModal.show();
            }
        </script>
</body>

</html>