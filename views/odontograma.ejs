<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Odontograma</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <style>
        .odontograma {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            max-width: 900px;
            margin: auto;
        }
        
        .pieza {
            width: 50px;
            height: 50px;
            margin: 5px;
            border: 2px solid #000;
            text-align: center;
            line-height: 50px;
            cursor: pointer;
            border-radius: 8px;
            position: relative;
            font-weight: bold;
            background-color: #fff;
        }
        
        .pieza.superior {
            border-color: #007bff;
        }
        
        .pieza.inferior {
            border-color: #28a745;
        }
        
        .pieza:hover {
            box-shadow: 0 0 5px #666;
        }
        
        .cuadrante-label {
            width: 100%;
            text-align: center;
            margin-top: 20px;
            font-weight: bold;
            font-size: 1.2em;
        }
        
        .icono-condicion {
            font-size: 18px;
            margin: 0 4px;
            cursor: pointer;
        }
        
        .leyenda {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 30px;
        }
        
        .leyenda-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }
    </style>
</head>

<body>
    <div class="container mt-4">
        <h3 class="text-center mb-4">Odontograma Interactivo</h3>

        <div class="odontograma">

            <div class="cuadrante-label">Cuadrante Superior Derecho</div>
            <% for (let i = 18; i >= 11; i--) { %>
                <div class="pieza superior" data-numero="<%= i %>">
                    <%= i %>
                </div>
                <% } %>

                    <div class="cuadrante-label">Cuadrante Superior Izquierdo</div>
                    <% for (let i = 21; i <= 28; i++) { %>
                        <div class="pieza superior" data-numero="<%= i %>">
                            <%= i %>
                        </div>
                        <% } %>

                            <div class="cuadrante-label">Cuadrante Inferior Izquierdo</div>
                            <% for (let i = 38; i >= 31; i--) { %>
                                <div class="pieza inferior" data-numero="<%= i %>">
                                    <%= i %>
                                </div>
                                <% } %>

                                    <div class="cuadrante-label">Cuadrante Inferior Derecho</div>
                                    <% for (let i = 41; i <= 48; i++) { %>
                                        <div class="pieza inferior" data-numero="<%= i %>">
                                            <%= i %>
                                        </div>
                                        <% } %>

        </div>

        <div class="leyenda mt-5">
            <div class="leyenda-item"><i class="fas fa-circle text-danger icono-condicion"></i> Caries</div>
            <div class="leyenda-item"><i class="fas fa-times text-secondary icono-condicion"></i> Ausente</div>
            <div class="leyenda-item"><i class="fas fa-tooth text-warning icono-condicion"></i> Empaste</div>
            <div class="leyenda-item"><i class="fas fa-star text-primary icono-condicion"></i> Tratado</div>
        </div>
    </div>

    <script>
        const piezas = document.querySelectorAll('.pieza');

        piezas.forEach(pieza => {
            pieza.addEventListener('click', () => {
                const seleccion = prompt("Selecciona una condición:\n1. Caries\n2. Ausente\n3. Empaste\n4. Tratado");
                let icon = '';
                switch (seleccion) {
                    case '1':
                        icon = '<i class="fas fa-circle text-danger"></i>';
                        break;
                    case '2':
                        icon = '<i class="fas fa-times text-secondary"></i>';
                        break;
                    case '3':
                        icon = '<i class="fas fa-tooth text-warning"></i>';
                        break;
                    case '4':
                        icon = '<i class="fas fa-star text-primary"></i>';
                        break;
                    default:
                        icon = '';
                        break;
                }
                pieza.innerHTML = `${pieza.dataset.numero}<br>${icon}`;
            });
        });
    </script>
</body>

</html>