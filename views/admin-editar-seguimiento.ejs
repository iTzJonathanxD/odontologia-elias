<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Editar Seguimiento</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body>
    <%- include('adminHOMEheader') %>

        <div class="container mt-4 mb-5">
            <h3 class="mb-4">Editar Seguimiento -
                <%= paciente.nombre %>
            </h3>

            <form method="POST" action="/admin/editar-seguimiento/<%= seguimiento.id %>">
                <div class="mb-3">
                    <label class="form-label">Tratamientos</label>
                    <textarea class="form-control" name="tratamientos" rows="2"><%= seguimiento.tratamientos %></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Observaciones</label>
                    <textarea class="form-control" name="observaciones" rows="2"><%= seguimiento.observaciones %></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Medicamentos</label>
                    <textarea class="form-control" name="medicamentos" rows="2"><%= seguimiento.medicamentos %></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Prescripción</label>
                    <textarea class="form-control" name="prescripcion" rows="2"><%= seguimiento.prescripcion %></textarea>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-success">Guardar Cambios</button>
                    <a href="/admin/historial-clinico/<%= paciente.id %>/ver-seguimientos" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
</body>

</html>