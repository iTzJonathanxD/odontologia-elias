<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <title>Receta Médica -
        <%= paciente.nombre %>
    </title>
    <style>
        @page {
            size: landscape;
            margin: 1cm;
        }
        
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background-color: #fefefe;
            color: #333;
        }
        
        .container {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            padding: 2cm;
            gap: 20px;
        }
        
        .receta {
            flex: 1;
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 20px;
            background-color: #fff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        
        .header-logo {
            text-align: center;
            margin-bottom: 10px;
        }
        
        .header-logo img {
            max-height: 60px;
        }
        
        .doctor-name {
            font-weight: 700;
            font-size: 1rem;
            color: #004085;
            font-family: 'Arial Black', Arial, sans-serif;
            letter-spacing: 0.05em;
        }
        
        h1 {
            font-size: 1.4rem;
            text-align: center;
            color: #004085;
            margin: 10px 0 20px;
            border-bottom: 2px solid #007bff;
            padding-bottom: 5px;
        }
        
        .datos-paciente p {
            margin: 4px 0;
            font-size: 14px;
        }
        
        h3 {
            color: #0056b3;
            margin-bottom: 10px;
            text-align: center;
            font-size: 16px;
        }
        
        pre {
            white-space: pre-wrap;
            font-family: monospace;
            color: #555;
            font-size: 14px;
        }
        
        .bloques {
            display: flex;
            gap: 10px;
        }
        
        .bloque {
            flex: 1;
            border: 1px solid #ccc;
            border-radius: 6px;
            padding: 10px;
            background-color: #fdfdfd;
        }
        
        .btn-print {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 10px 20px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 5px;
            display: block;
            margin: 20px auto;
        }
        
        .btn-print:hover {
            background-color: #0056b3;
        }
        
        @media print {
            .btn-print {
                display: none;
            }
        }
    </style>
</head>

<body>

    <button class="btn-print" onclick="window.print()">🖨️ Imprimir Receta Médica</button>

    <div class="container">
        <!-- Primera mitad de la receta -->
        <div class="receta">
            <div class="header-logo">
                <img src="/images/Logo.jpg" alt="Logo del consultorio" />
                <div class="doctor-name">Dra. Joseline Delgado<br>Odontología Especializada</div>
            </div>

            <h1>Receta Médica</h1>

            <div class="datos-paciente">
                <p><strong>Nombre:</strong>
                    <%= paciente.nombre %>
                </p>
                <p><strong>Documento:</strong>
                    <%= paciente.cedula || paciente.pasaporte || 'No especificado' %>
                </p>
                <p><strong>Fecha:</strong> <span id="fecha-receta-1"></span></p>
            </div>

            <div class="bloques">
                <div class="bloque">
                    <h3>Medicamentos</h3>
                    <pre><%= historial.medicamentos || 'No especificado' %></pre>
                </div>
            </div>
        </div>

        <!-- Segunda mitad (duplicado) -->
        <div class="receta">
            <div class="header-logo">
                <img src="/images/Logo.jpg" alt="Logo del consultorio" />
                <div class="doctor-name">Dra. Joseline Delgado<br>Odontología Especializada</div>
            </div>

            <h1>Receta Médica</h1>

            <div class="datos-paciente">
                <p><strong>Nombre:</strong>
                    <%= paciente.nombre %>
                </p>
                <p><strong>Documento:</strong>
                    <%= paciente.cedula || paciente.pasaporte || 'No especificado' %>
                </p>
                <p><strong>Fecha:</strong> <span id="fecha-receta-2"></span></p>
            </div>

            <div class="bloques">
                <div class="bloque">
                    <h3>Prescripción</h3>
                    <pre><%= historial.prescripcion || 'No especificado' %></pre>
                </div>
            </div>
        </div>
    </div>

    <script>
        const fechaActual = new Date();
        const dia = String(fechaActual.getDate()).padStart(2, '0');
        const mes = String(fechaActual.getMonth() + 1).padStart(2, '0');
        const anio = fechaActual.getFullYear();
        const fechaFormateada = `${dia}/${mes}/${anio}`;

        document.getElementById('fecha-receta-1').textContent = fechaFormateada;
        document.getElementById('fecha-receta-2').textContent = fechaFormateada;
    </script>

</body>

</html>