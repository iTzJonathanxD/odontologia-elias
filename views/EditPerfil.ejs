<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Editar Perfil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .fadeIn {
            animation: fadeIn 0.5s ease-in-out forwards;
        }
        
        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
    </style>
</head>

<body>
    <%- include('HOMEheader') %>
        <div class="container my-5 fadeIn">
            <h1 class="mb-4">ACTUALICE SUS DATOS</h1>

            <% if (message) { %>
                <div class="alert alert-<%= message.type %> d-flex align-items-center" role="alert">
                    <% if (message.type === 'success') { %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="green" class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM6.97 11.03a.75.75 0 0 0 1.07 0l4-4a.75.75 0 1 0-1.06-1.06L7.5 9.44 6.03 7.97a.75.75 0 1 0-1.06 1.06l2 2z" />
            </svg>
                        <% } %>
                            <div>
                                <%= message.text %>
                            </div>
                </div>
                <% if (message.type === 'success') { %>
                    <script>
                        setTimeout(() => {
                            window.location.href = "/obtener-citas";
                        }, 1000);
                    </script>
                    <% } %>
                        <% } %>

                            <form action="/EditPerfil" method="POST" enctype="multipart/form-data">
                                <!-- Foto de perfil -->
                                <label for="foto_perfil" class="form-label mt-3">Foto de Perfil</label>
                                <input type="file" name="foto_perfil" id="foto_perfil" accept="image/*" class="form-control form-control-sm mb-4" />

                                <!-- Sexo, Fecha Nacimiento y Edad -->
                                <div class="row g-3 mb-3">
                                    <div class="col-md-4">
                                        <label for="sexo" class="form-label">Sexo</label>
                                        <select class="form-select form-select-sm" id="sexo" name="sexo" required>
                        <option value="">Seleccione</option>
                        <option value="M" <%= user.sexo === 'M' ? 'selected' : '' %>>Masculino</option>
                        <option value="F" <%= user.sexo === 'F' ? 'selected' : '' %>>Femenino</option>
                    </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="fecha_nacimiento" class="form-label">Fecha de Nacimiento</label>
                                        <input type="date" class="form-control form-control-sm" id="fecha_nacimiento" name="fecha_nacimiento" value="<%= user.fecha_nacimiento || '' %>" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="edad" class="form-label">Edad</label>
                                        <input type="number" class="form-control form-control-sm" id="edad" name="edad" value="<%= user.edad || '' %>" readonly>
                                    </div>
                                </div>

                                <!-- Contacto y ubicación -->
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label for="celular" class="form-label">Número de Celular</label>
                                        <input type="tel" class="form-control form-control-sm" id="celular" name="celular" value="<%= user.celular || '' %>" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="ciudad" class="form-label">Ciudad</label>
                                        <input type="text" class="form-control form-control-sm" id="ciudad" name="ciudad" value="<%= user.ciudad || '' %>" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="barrio" class="form-label">Barrio</label>
                                        <input type="text" class="form-control form-control-sm" id="barrio" name="barrio" value="<%= user.barrio || '' %>" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="ocupacion" class="form-label">Ocupación</label>
                                        <input type="text" class="form-control form-control-sm" id="ocupacion" name="ocupacion" value="<%= user.ocupacion || '' %>" required>
                                    </div>
                                </div>



                                <button type="submit" class="btn btn-primary btn-sm">Guardar Cambios</button>
                            </form>
        </div>

        <script>
            document.getElementById('fecha_nacimiento').addEventListener('change', function() {
                const fecha = new Date(this.value);
                const hoy = new Date();
                let edad = hoy.getFullYear() - fecha.getFullYear();
                const m = hoy.getMonth() - fecha.getMonth();
                if (m < 0 || (m === 0 && hoy.getDate() < fecha.getDate())) {
                    edad--;
                }
                document.getElementById('edad').value = edad;
            });
        </script>
</body>

</html>